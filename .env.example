# Copy to .env and fill in as needed. TM_LLM_PROVIDER=mock works out of the
# box with zero API keys (deterministic rule-based fallback for every pipeline step).

TM_ENVIRONMENT=dev
TM_SECRET_KEY=change-this-to-something-random-in-production

# SQLite only — no Postgres. Created automatically on first run.
TM_DATABASE_PATH=data/threatmodel.db

# LLM provider: mock | openai | azure_openai | ollama | anthropic
TM_LLM_PROVIDER=mock
TM_LLM_MODEL=gpt-4o-mini
TM_LLM_API_KEY=
TM_LLM_API_BASE=

# RAG (optional — requires `pip install chromadb sentence-transformers`)
TM_VECTOR_STORE=chroma
TM_EMBEDDING_PROVIDER=sentence-transformers
TM_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Safety (controlled test execution) — never remove execution_require_explicit_authorization in a real deployment
TM_EXECUTION_REQUIRE_EXPLICIT_AUTHORIZATION=true
TM_EXECUTION_MAX_REQUESTS_PER_TEST=25
TM_EXECUTION_RATE_LIMIT_PER_SECOND=5
TM_EXECUTION_TIMEOUT_SECONDS=15
